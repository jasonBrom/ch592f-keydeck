set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(C5_CROSS_PREFIX "riscv-none-embed-" CACHE STRING "WCH RISC-V toolchain executable prefix")
set(CMAKE_C_COMPILER "${C5_CROSS_PREFIX}gcc")
set(CMAKE_ASM_COMPILER "${C5_CROSS_PREFIX}gcc")
set(CMAKE_OBJCOPY "${C5_CROSS_PREFIX}objcopy" CACHE FILEPATH "objcopy")
set(CMAKE_SIZE "${C5_CROSS_PREFIX}size" CACHE FILEPATH "size")
